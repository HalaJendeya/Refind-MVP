rules_version = '2';

// ReFind Firestore rules.
// Every memory lives at users/{userId}/memories/{memoryId}.
// A signed-in user can only touch documents under their OWN user id.
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId}/memories/{memoryId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;

      allow create, update: if request.auth != null
                            && request.auth.uid == userId
                            && request.resource.data.userId == userId
                            && request.resource.data.title is string
                            && request.resource.data.title.size() <= 500;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
